# Job Hunter Africa — copy this file to ".env" (in this folder or one folder up) and fill in.

# --- Fayisa AI (one of these) ---
PORTKEY_API_KEY=
# OPENAI_API_KEY=
MODEL=gpt-6-luna
FAYISA_WEB_SEARCH=1
FAYISA_DAILY_TOKEN_CAP=300000

# --- Your owner (admin) login ---
OWNER_EMAIL=thejobhuntergh@gmail.com
OWNER_PASSWORD=choose-a-strong-password-here

# --- Email codes (Gmail: turn on 2-Step Verification, then create an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thejobhuntergh@gmail.com
SMTP_PASS=
SMTP_FROM=thejobhuntergh@gmail.com

PORT=8000

# Cost tracking: fill in the course prices; do not guess these values.
PRICE_INPUT=
PRICE_CACHED=
PRICE_OUTPUT=
COST_SIMPLE_SEARCH=1
COST_CACHE_24H=1
COST_SKIP_HIGH=1
COST_MAX_OUTPUT=1200

# Deployment: use 0.0.0.0 on a hosted server; keep localhost for local use.
HOST=127.0.0.1
SMTP_TIMEOUT=8
